# FoveaMap AI - Environment Configuration Placeholder
# In production, backend services and live LiDAR WebSocket feeds connect through these variables.

# API Base URL (gRPC-Web / REST endpoint for map metadata & scene queries)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real-time LiDAR Point Cloud Stream URL (WebSocket / WebRTC / ROS2 Bridge)
VITE_LIDAR_STREAM_WS=ws://localhost:8765/lidar/stream

# Semantic Deep Learning Inference Service Endpoint
VITE_SEMANTIC_MODEL_ENDPOINT=http://localhost:8001/v1/models/foveamap-salsanext:predict

# Mapping Engine Connection URL
VITE_MAPPING_ENGINE_WS=ws://localhost:8766/map/adaptive-grid

# Feature Flags
VITE_ENABLE_MOCK_FALLBACK=false
VITE_DEFAULT_MODEL_NAME=SalsaNext-Fovea-v2
